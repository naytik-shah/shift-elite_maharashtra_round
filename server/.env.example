# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://fairdrop:fairdrop@127.0.0.1:5433/fairdrop
DB_POOL_MAX=30
REDIS_URL=redis://127.0.0.1:6380
SESSION_SECRET=change-me-64-random-hex-characters
ANCHOR_PEPPER=change-me-64-random-hex-characters
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:5173
DROPS_CONFIG_PATH=../config/drops.yaml
DISPOSABLE_DOMAINS_PATH=../config/disposable-domains.txt

# Test access: requests with X-Test-Key equal to this get dev codes, test IPs and easy puzzles.
# Leave empty to switch test access off.
TEST_KEY=
POW_DIFFICULTY=18
TEST_POW_DIFFICULTY=8

# Gmail SMTP with an app password. If SMTP_HOST is empty, emails are only logged (never in production).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fair Drop <no-reply@example.com>

# Scoring service (added later). While empty, the draw gives everyone weight 1.0.
SCORING_URL=
WORKER_INTERVAL_MS=10000
LOG_LEVEL=info
