FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY server/src ./src
COPY server/migrations ./migrations
# The drop settings and the disposable email list live outside server/, so they are baked in here.
COPY config /app/config

USER node
EXPOSE 10000
# The API by default. The worker service overrides the command.
CMD ["node", "src/index.js"]
