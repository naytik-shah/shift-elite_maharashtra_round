# Copy to deploy/.env on the server and fill in. Never commit the real file.
HTTP_PORT=80
POSTGRES_PASSWORD=change-me
PG_SHARED_BUFFERS=512MB

# Secrets: 64 random hex characters each (openssl rand -hex 32)
SESSION_SECRET=
ANCHOR_PEPPER=
# Test access for the simulator and smoke test. Leave empty to switch it off.
TEST_KEY=

PUBLIC_BASE_URL=https://example.sslip.io
COOKIE_SECURE=true
POW_DIFFICULTY=18
TEST_POW_DIFFICULTY=8
DB_POOL_MAX=30
LOG_LEVEL=info

# Demo only: a fixed six digit login code for participants and the dummy organiser. Leave empty on any public server.
DEMO_BYPASS_CODE=

# Gmail SMTP with an app password. If SMTP_HOST is empty, emails are only logged.
# Easiest way to fill these in safely: bash deploy/set-gmail.sh (it asks for the address and the app password).
# To try email without sending anything: add -f deploy/docker-compose.mailtest.yml and read it at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fair Drop <no-reply@example.com>

# Add ",/app/config/drops.test.yaml" only on a test machine.
DROPS_CONFIG_PATH=/app/config/drops.yaml

# Scoring: the two-signal guard keeps a weight at 1.0 unless two signal families agree (PRD 9.2). 0 switches it off.
TWO_SIGNAL_GUARD=1

# Demo only: organiser tools to add an event, reset every event and send a simulated crowd. Leave empty on a public server.
DEMO_TOOLS=
